# Nex Heuristic Cue Service
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY heuristic_pipeline/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir redis>=5.0

# Copy the pipeline source
COPY heuristic_pipeline/ /app/heuristic_pipeline/

WORKDIR /app/heuristic_pipeline

# Healthcheck — verifies the service process is alive
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import redis, os; r=redis.from_url(os.environ['REDIS_URL']); r.ping()" || exit 1

CMD ["python", "service.py"]
