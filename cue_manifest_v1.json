    "physical_instability": {
      "cues": [
        {
          "code": "near_fall",
          "source": "heuristic",
          "module": "fall_detection",
          "sub_path": "dynamic",
          "status": "demo_ready",
          "confidence_range": [0.45, 0.95],
          "emit_threshold": 0.50,
          "score_description": "Composite of body-angle depth into danger zone [20–60 deg] + rapid-tilt flag + instability signal count (arms raised, CoM off base)."
        },
        {
          "code": "lying_or_collapsed",
          "source": "heuristic",
          "module": "fall_detection",
          "sub_path": "geometry_or_surface_rest",
          "status": "demo_ready",
          "confidence_range": [0.45, 0.95],
          "emit_threshold": 0.50,
          "score_description": "Geometry path: lying_score (0–3+) + number of secondary signals (vspan, joints-y, aspect-ratio). Surface-rest path: inverse head-stillness variance."
        },
        {
          "code": "head_drop",
          "source": "heuristic",
          "module": "head_drop",
          "status": "demo_ready",
          "confidence_range": [0.45, 1.0],
          "emit_threshold": 0.45,
          "score_description": "0.45 base when shoulder-width collapses (head-on profile). +0.35 when nose-Y drops below shoulder level. +0.20 when nose-Y drops over the window (temporal change signal)."
        },
        {
          "code": "slumped_posture",
          "source": "heuristic",
          "module": "slumped_posture",
          "status": "demo_ready",
          "confidence_range": [0.45, 0.90],
          "emit_threshold": 0.45,
          "score_description": "Fraction of 4-s window frames where shoulder/hip width ratio < 0.75 AND spine angle > 20 deg. Scaled: [min_hit_ratio → 1.0] maps to [0.45 → 0.90]."
        },
        {
          "code": "leaning_on_surface_or_person",
